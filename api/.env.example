# Local default (no cloud password needed)
DATABASE_URL=sqlite+aiosqlite:///./pollr.local.db

# Optional later: Docker Postgres
# DATABASE_URL=postgresql+asyncpg://pollr:pollr@127.0.0.1:5433/pollr

# Optional later: Supabase Postgres
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
IP_HASH_SALT=change-me-in-production
